<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TrackToken" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/neon_green</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/neon_green_dim</item>
        <item name="colorOnPrimaryContainer">@color/neon_green</item>
        <item name="colorSecondary">@color/neon_cyan</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorTertiary">@color/neon_magenta</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/text_body</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorError">@color/alert</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/text_body</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Base of the Widget.TrackToken.* styles; dotted names inherit from it implicitly. -->
    <style name="Widget.TrackToken" parent="@android:style/Widget" />

    <style name="Widget.TrackToken.Card">
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="Widget.TrackToken.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">2dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="backgroundTint">@color/neon_green</item>
        <item name="android:textColor">@color/black</item>
        <item name="strokeColor">@color/neon_green</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.TrackToken.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">2dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="strokeColor">@color/alert</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/alert</item>
    </style>

    <style name="Widget.TrackToken.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/neon_green</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/neon_cyan</item>
        <item name="android:fontFamily">monospace</item>
        <item name="boxCornerRadiusTopStart">2dp</item>
        <item name="boxCornerRadiusTopEnd">2dp</item>
        <item name="boxCornerRadiusBottomStart">2dp</item>
        <item name="boxCornerRadiusBottomEnd">2dp</item>
    </style>

</resources>
