<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgt_panel_cyan"
    android:orientation="vertical"
    android:padding="11dp">

    <TextView
        android:id="@+id/pulse_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:text="CREDIT PULSE"
        android:textColor="#00F5FF"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pulse_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:text="--"
        android:textColor="#39FF14"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pulse_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:text="NO API KEYS LINKED"
        android:textColor="#9DB3AA"
        android:textSize="9sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/wgt_seg_track">

            <View
                android:id="@+id/seg_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/wgt_seg_on"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/wgt_seg_track">

            <View
                android:id="@+id/seg_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/wgt_seg_on"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/wgt_seg_track">

            <View
                android:id="@+id/seg_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/wgt_seg_on"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/wgt_seg_track">

            <View
                android:id="@+id/seg_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/wgt_seg_on"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/wgt_seg_track">

            <View
                android:id="@+id/seg_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/wgt_seg_on"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/wgt_seg_track">

            <View
                android:id="@+id/seg_5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/wgt_seg_on"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/wgt_seg_track">

            <View
                android:id="@+id/seg_6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/wgt_seg_on"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/wgt_seg_track">

            <View
                android:id="@+id/seg_7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/wgt_seg_on"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/pulse_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:text="sync --:--"
        android:textColor="#6B8078"
        android:textSize="8sp" />

</LinearLayout>
