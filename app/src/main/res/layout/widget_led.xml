<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wgt_panel_magenta"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="11dp">

    <TextView
        android:id="@+id/led_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.22"
        android:text="CREDITS REMAINING"
        android:textColor="#FF2BD6"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/led_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.04"
        android:singleLine="true"
        android:text="--"
        android:textColor="#39FF14"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/led_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="5dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/wgt_bar_magenta" />

    <TextView
        android:id="@+id/led_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:text="NO API KEYS LINKED"
        android:textColor="#6B8078"
        android:textSize="8sp" />

</LinearLayout>
